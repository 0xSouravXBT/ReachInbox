PORT=4000
FRONTEND_URL=http://localhost:5173
DOCKER_FRONTEND_URL=http://localhost:8080
DATABASE_URL=postgresql://reachinbox:reachinbox-local-only@localhost:5432/reachinbox?schema=public
POSTGRES_PASSWORD=reachinbox-local-only
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Configure OAuth credentials and exact callback URLs in Google Cloud Console and Slack.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1

# Each sender needs a real Ethereal SMTP account (create one at https://ethereal.email).
# JSON array: [{"email":"hello@example.test","name":"ReachInbox Demo","user":"...","pass":"...","host":"smtp.ethereal.email","port":587}]
EMAIL_SENDERS=[]
DEFAULT_MAX_EMAILS_PER_HOUR=100
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5
AUTH_REQUESTS_PER_MINUTE=20
SCHEDULE_REQUESTS_PER_MINUTE=30
READ_REQUESTS_PER_MINUTE=120

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=
